# Supabase — H3(계정·로그인). 실제 값은 이 파일을 .env로 복사해서 채운다.
# .env는 git에 안 올라간다(.gitignore) — 이 파일(.env.example)만 커밋 대상이다.
#
# 값은 Supabase 대시보드 → 프로젝트 → "Get Connected" 팝업 또는
# Project Settings → API Keys 에서 가져온다.

# Project URL — "Get Connected" 팝업 첫 줄
SUPABASE_URL=

# Publishable key(구 anon key, sb_publishable_로 시작) — 클라이언트에 노출돼도 되는 값
SUPABASE_ANON_KEY=

# Secret key(구 service_role key, sb_secret_로 시작) — server-api 전용, 클라이언트에 절대 노출 금지
# Project Settings → API Keys → Secret keys 에서 가져온다("Get Connected" 팝업에는 없다)
SUPABASE_SECRET_KEY=

# Direct connection string — server-api가 raw SQL로 Postgres에 붙을 때
# "Get Connected" 팝업 세 번째 줄. [YOUR-PASSWORD] 자리에 프로젝트 생성 시 정한 DB 비밀번호를 넣는다
SUPABASE_DB_URL=
