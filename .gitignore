node_modules/
dist/
*.tsbuildinfo
.DS_Store

# 추출 결과는 커밋한다 (엑셀 없이도 빌드 가능해야 함)
# packages/data/generated/  ← 무시하지 않음

# ── 이미지는 리포에 올리지 않는다 ─────────────────────────────
# assets/Chars/          초상화 260장 (440×540, 배경 없음). 보드 타일의 원본
# assets/CharsInBattle/  수묵화 흉상 260장. 하단 패널·정보 팝업의 원본
# assets/SpecialSkills/  고유기술 연출 40장
# assets/SpecialStatus/  시각 효과 30장 (지속형 링 23 + 일회성 7)
#
# PNG는 델타 압축이 안 먹어서 한번 히스토리에 들어가면 영구히 남는다.
# 로컬 보관 + 별도 백업으로 관리하고, 배포 시에는 정적 호스팅/CDN으로 따로 올린다.
#
# 없어도 빌드는 된다 — extract_data.py는 Chars가 없으면 260명 ↔ 260장 대조를
# "건너뛴다"고 알리고 통과한다. 대조까지 돌리려면 로컬에 Chars가 있어야 한다.
assets/

# 상류 자료(Gemini 원본 카드 `Images/`, 배경 있던 예전 `Chars/`)는 2026-08-07에
# 기획자가 별도 백업으로 옮겨 로컬 작업 폴더에 없다. 위 `assets/` 한 줄이 어차피
# 전부 덮으므로 따로 적을 것은 없다 — 되돌릴 일이 생기면 백업에서 꺼낸다.

# 웹용 축소 에셋 — assets/에서 생성된다 (python tools/build_portraits.py)
packages/client/public/portraits/
packages/client/public/battle/
packages/client/public/skills/
packages/client/public/actions/
packages/client/public/vfx/
packages/client/public/terrain/
packages/client/public/ui/
packages/client/public/bgm/
packages/client/public/backgrounds/
packages/client/dist/

# tsc 산출물 (.d.ts). packages/rules 쪽과 마찬가지로 커밋하지 않는다 —
# 아무도 import하지 않는데 소스를 고칠 때마다 diff에 따라붙는다.
packages/client/dist-types/

# Office가 문서를 열면 만드는 임시 잠금 파일 (docs/~$*.pptx)
~$*

# Python 바이트코드 캐시 (tools/를 import할 때 생긴다)
__pycache__/
*.pyc
