{
  "name": "samchess",
  "version": "0.1.0",
  "private": true,
  "description": "삼국 약식 체스 — Three Kingdoms simplified chess",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "extract": "python tools/extract_data.py",
    "typecheck": "tsc --build",
    "typecheck:admin": "node --experimental-strip-types tools/typecheck_admin.ts",
    "test": "node --test --experimental-strip-types packages/*/test/*.test.ts",
    "balance": "node --experimental-strip-types tools/balance.ts",
    "balance:siege": "node --experimental-strip-types tools/siege_balance.ts",
    "power": "node --experimental-strip-types tools/power_fit.ts",
    "dev": "npm run dev -w @samchess/client",
    "portraits": "python tools/build_portraits.py",
    "actions": "python tools/build_action_sheets.py",
    "vfx": "python tools/build_status_fx.py",
    "terrain": "python tools/build_terrain.py",
    "frames": "python tools/build_frames.py",
    "backgrounds": "python tools/build_backgrounds.py",
    "audio": "python tools/build_audio.py",
    "opening": "python tools/build_opening.py",
    "market": "python tools/build_market.py",
    "collections": "python tools/build_collections.py",
    "burst": "python tools/build_burst.py",
    "dice": "python tools/build_dice.py",
    "blacksmith": "python tools/build_blacksmith.py",
    "market-items": "python tools/build_market_items.py",
    "ui": "python tools/build_ui.py",
    "shot": "node --experimental-strip-types tools/shot.ts",
    "smoke:ui": "node --experimental-strip-types tools/smoke_ui.ts",
    "smoke:meta": "node --experimental-strip-types --env-file=.env tools/smoke_meta.ts",
    "server": "node --experimental-strip-types --env-file=.env packages/server/src/main.ts",
    "smoke:online": "node --experimental-strip-types --env-file=.env tools/smoke_online.ts",
    "server-api": "node --experimental-strip-types --env-file=.env packages/server-api/src/main.ts",
    "db:migrate": "node --experimental-strip-types --env-file=.env tools/migrate_db.ts",
    "db:migrate:prod": "node --experimental-strip-types --env-file=.env.production tools/migrate_db.ts",
    "db:check": "node --experimental-strip-types --env-file=.env tools/db_check.ts",
    "db:check:prod": "node --experimental-strip-types --env-file=.env.production tools/db_check.ts",
    "smoke:account": "node --experimental-strip-types --env-file=.env tools/smoke_account.ts",
    "smoke:forge": "node --experimental-strip-types --env-file=.env tools/forge_play.ts",
    "smoke:raid": "node --experimental-strip-types --env-file=.env tools/raid_play.ts",
    "look:online": "node --experimental-strip-types --env-file=.env tools/online_look.ts",
    "smoke:forge-ux": "node --experimental-strip-types --env-file=.env tools/forge_ux.ts",
    "smoke:academy-ux": "node --experimental-strip-types --env-file=.env tools/academy_ux.ts",
    "smoke:settings-ux": "node --experimental-strip-types tools/settings_ux.ts",
    "smoke:market-ux": "node --experimental-strip-types --env-file=.env tools/market_ux.ts",
    "smoke:siege-ux": "node --experimental-strip-types --env-file=.env tools/siege_ux.ts",
    "smoke:war-ux": "node --experimental-strip-types --env-file=.env tools/war_ux.ts",
    "smoke:defense-ux": "node --experimental-strip-types --env-file=.env tools/defense_ux.ts",
    "smoke:policy-ux": "node --experimental-strip-types --env-file=.env tools/garrison_policy_ux.ts",
    "admin-api": "node --experimental-strip-types --env-file=.env packages/server-api/src/admin/main.ts",
    "admin:role": "node --experimental-strip-types --env-file=.env tools/admin_role.ts",
    "admin:role:prod": "node --experimental-strip-types --env-file=.env.production tools/admin_role.ts",
    "smoke:admin": "node --experimental-strip-types --env-file=.env tools/smoke_admin.ts",
    "seed:forge": "node --experimental-strip-types --env-file=.env tools/forge_seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0"
  }
}
